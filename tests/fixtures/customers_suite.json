{
  "expectation_suite_name": "customers_suite",
  "meta": {
    "great_expectations_version": "1.0.0",
    "description": "CI expectations for customers fixture (row counts adjusted for small dataset)"
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 3,
        "max_value": 20
      },
      "meta": {"notes": "CI fixture has 5 rows"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "customer_id"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "customer_unique_id"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "customer_city"}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "customer_state"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "customer_id"}
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {"column": "customer_id"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "customer_unique_id"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "customer_city"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "customer_state"}
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "customer_state",
        "regex": "^[A-Z]{2}$"
      }
    },
    {
      "expectation_type": "expect_column_value_lengths_to_be_between",
      "kwargs": {
        "column": "customer_city",
        "min_value": 1,
        "max_value": 100
      }
    }
  ]
}
