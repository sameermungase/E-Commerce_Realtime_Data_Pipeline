# ================================================================
# E-Commerce Data Pipeline — Environment Variables
# ================================================================
# Copy this file to .env and fill in the required values.
# Required variables are marked with [REQUIRED].
#
#   cp .env.example .env
#   # Edit .env with your local paths
# ================================================================

# ── Java (PySpark) ──────────────────────────────────────────────
# [REQUIRED] Path to your Java 21 installation
JAVA_HOME=C:\Program Files\Java\latest\jdk-21\Java

# ── PostgreSQL ──────────────────────────────────────────────────
# Defaults match docker-compose.yml — override for remote/custom setups
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ── AWS Data Lakehouse (optional) ───────────────────────────────
# Uncomment and set to enable S3 + Athena dual-warehouse loading
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET_NAME=your-s3-bucket-name
# ATHENA_DATABASE=ecommerce_raw
# ATHENA_S3_STAGING_DIR=s3://your-s3-bucket-name/athena-staging/
# ENABLE_AWS_LAKEHOUSE=false

# ── Kafka (Streaming) ──────────────────────────────────────────
# Defaults match docker-compose.yml
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# KAFKA_TOPIC=orders_stream

# ── Debug / Development ─────────────────────────────────────
# Set to 'true' to enable row-count logging after each ETL step (slower)
# ETL_DEBUG=false

# ── Airflow (optional, for non-Docker Airflow) ─────────────────
# PROJECT_DIR=C:\path\to\files
# VENV_PYTHON=C:\path\to\.venv\Scripts\python.exe

# ── Airflow Docker ──────────────────────────────────────────────
# Admin credentials for Airflow webserver (default: admin/admin)
# AIRFLOW_USER=admin
# AIRFLOW_PASSWORD=admin

# ── Observability (optional) ────────────────────────────────────
# Set to receive Slack alerts on pipeline task failures
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

